            "type": "text",
            "unit": null
          },
          "Date_ Time GMT_BST": {
            "description": "The date and time for the given limit and flow through the constraint boundary. This is given in a MM/DD/YYYY HH:MM format. The flow and limit for each constraint group is given for a day, before moving onto the next day. Data is given on a settlement period (half hourly) basis.",
            "title": "Date (GMT/BST)",
            "type": "timestamp",
            "unit": null
          },
          "Flow_MW": {
            "description": "A snapshot of the power flows across a number of important constraint boundaries at day ahead. This power flow forecast is created based on the next day’s wind forecast, generation dispatch and demand forecast and is modelled using power system software.",
