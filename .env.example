# Copy to .env and fill in what you need; every line is optional.
# .env is gitignored — never commit secrets
# Only ENTSO-E and GIE need a key, both free; Elexon, ENTSO-G, NESO and Open-Meteo
# are public. Without a key, `gridflow backfill --preset tour` skips that source
# with a line naming the variable, and the notebooks skip its sections.

# ENTSO-E Transparency Platform: the `entsoe` source, EU day-ahead prices, load,
# generation, cross-border flows and outages (the ENTSO-E section of
# notebooks/01_sources.py, and its day-ahead prices in the tour preset).
# Register at https://transparency.entsoe.eu/, then request RESTful API access and
# generate a token under My Account Settings:
# https://transparencyplatform.zendesk.com/hc/en-us/articles/12845911031188-How-to-get-security-token
ENTSOE_API_KEY=

# GIE AGSI+ and ALSI: the `gie_agsi` source (EU gas storage) and `gie_alsi`
# (LNG terminals), one key for both (the GIE section of notebooks/01_sources.py,
# and storage and LNG in the tour preset).
# Register under API at https://agsi.gie.eu/account or https://alsi.gie.eu/account
GIE_API_KEY=

# Optional: the data root (default ~/gridflow-data, whichever folder you run from).
# Use forward slashes: an unquoted C:\... loses its backslashes in a POSIX shell.
# GRIDFLOW_DATA_DIR=<data root>
# Optional: the catalogue and logs default to <data root>/gridflow.duckdb
# and <data root>/logs; set these only to put them elsewhere.
# GRIDFLOW_DUCKDB_PATH=<data root>/gridflow.duckdb
# GRIDFLOW_LOG_DIR=<data root>/logs
